{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longevity",
  "version": "1.0.1",
  "identifier": "com.mio.longevity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Longevity",
        "create": false,
        "width": 1320,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0b0d10",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force_high_performance_gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "mainBinaryName": "Longevity"
}
